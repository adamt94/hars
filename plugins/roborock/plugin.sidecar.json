{
  "schema_version": 1,
  "domain": "roborock",
  "name": "Roborock",
  "version": "0.1.0",
  "iot_class": "local_polling",
  "config_flow": true,
  "documentation": "https://www.home-assistant.io/integrations/roborock",
  "description": "Control Roborock vacuums and docks via a Docker sidecar container over Unix socket",
  "transport": {
    "type": "unix_socket"
  },
  "capabilities": {
    "entity_domains": [
      "vacuum",
      "sensor",
      "binary_sensor",
      "switch",
      "button"
    ],
    "config_entry_version": 1
  }
}
