[
 {
  "name": "welcome",
  "steps": [
   {
    "send": {
     "id": 1,
     "type": "render_template",
     "template": "## Welcome {{ user }}",
     "variables": {
      "config": {
       "type": "markdown",
       "text_only": true
      },
      "user": "Ann"
     },
     "strict": true,
     "report_errors": false
    },
    "replies": [
     {
      "id": 1,
      "type": "result",
      "success": true,
      "result": null
     },
     {
      "id": 1,
      "type": "event",
      "event": {
       "result": "## Welcome Ann",
       "listeners": {
        "all": false,
        "entities": [],
        "domains": [],
        "time": false
       }
      }
     }
    ]
   }
  ]
 },
